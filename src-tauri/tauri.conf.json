{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Breakevencalc",
  "version": "0.1.0",
  "identifier": "com.deralo.breakevencalc",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://10.205.157.61:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "withGlobalTauri": true,

    "windows": [
      {
        "title": "Breakevencalc",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true,


        "url": "index.html"
      }
    ],

    "security": {

      "csp": "default-src 'self' app: https://10.205.157.61:9000; img-src 'self' app: https://10.205.157.61:9000 data: blob:; connect-src 'self' app: https://10.205.157.61:9000 https://10.205.157.61:8080 ipc:; script-src 'self' app:; style-src 'self' 'unsafe-inline' app:;"
    }
  },

  "plugins": {
    "http": {
      "enabled": true,
      "permissions": {
        "default": true,
        "allow": [
          "https://10.205.157.61:9000",
          "https://10.205.157.61:8080"
        ]
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
